Sub FiltrarGTA6()

    '=========================================================================
    ' OBJETIVO
    '-------------------------------------------------------------------------
    ' Filtrar automaticamente conteúdos relacionados ao GTA 6 em uma base
    ' editorial do TechTudo.
    '
    ' PROBLEMÁTICA
    '-------------------------------------------------------------------------
    ' Durante análises de conteúdo, nem todas as matérias utilizam o termo
    ' "GTA 6" no título. Algumas publicações podem citar apenas variações
    ' como "GTA VI", "Grand Theft Auto VI", "Vice City", "Lucia",
    ' "Jason" ou referências à desenvolvedora Rockstar Games.
    '
    ' A identificação manual desses conteúdos torna o processo mais lento
    ' e aumenta o risco de deixar matérias relevantes fora da análise.
    '
    ' SOLUÇÃO
    '-------------------------------------------------------------------------
    ' Aplicar um filtro na coluna E utilizando múltiplas palavras-chave
    ' relacionadas ao universo de GTA 6, permitindo localizar rapidamente
    ' todos os conteúdos associados ao tema.
    '
    ' BENEFÍCIOS
    '-------------------------------------------------------------------------
    ' - Reduz o tempo gasto com filtragem manual.
    ' - Padroniza o processo de coleta de conteúdos.
    ' - Facilita análises editoriais e relatórios temáticos.
    ' - Permite expandir facilmente a lista de palavras-chave.
    '=========================================================================

    Dim ws As Worksheet
    Set ws = ActiveSheet

    ' Remove filtros existentes para evitar conflitos
    If ws.AutoFilterMode Then ws.AutoFilterMode = False

    ' Aplica filtro na coluna E (Field:=5)
    ' Considera diferentes formas de menção ao GTA 6
    ws.Range("A1").CurrentRegion.AutoFilter _
        Field:=5, _
        Criteria1:=Array( _
            "*GTA 6*", _
            "*GTA VI*", _
            "*Grand Theft Auto 6*", _
            "*Grand Theft Auto VI*", _
            "*Rockstar*", _
            "*Rockstar Games*", _
            "*Vice City*", _
            "*Lucia*", _
            "*Jason*", _
            "*Take-Two*", _
            "*Take Two*", _
            "*Take-Two Interactive*" _
        ), _
        Operator:=xlFilterValues

End Sub
