Sub FiltrarGTA6()

    ' =========================================================================
    ' FILTRO DE CONTEÚDOS SOBRE GTA 6
    ' =========================================================================
    '
    ' Problema:
    ' Durante análises editoriais do TechTudo, conteúdos sobre GTA 6 podem ser
    ' publicados utilizando diferentes termos, como "GTA VI", "Vice City",
    ' "Rockstar", "Lucia" ou "Jason". Isso torna a identificação manual das
    ' matérias mais lenta e sujeita a falhas.
    '
    ' Solução:
    ' A macro percorre os títulos da coluna E e mantém visíveis apenas as
    ' linhas que contenham palavras-chave relacionadas ao universo de GTA 6.
    '
    ' Benefícios:
    ' - Reduz o tempo de filtragem manual.
    ' - Padroniza a coleta de conteúdos.
    ' - Minimiza perdas de matérias relevantes na análise.
    '
    ' =========================================================================

    Dim ultimaLinha As Long
    Dim i As Long
    Dim texto As String
    Dim encontrou As Boolean

    ultimaLinha = Cells(Rows.Count, "E").End(xlUp).Row

    ' Exibe todas as linhas antes de aplicar o filtro
    Rows.Hidden = False

    For i = 2 To ultimaLinha

        texto = LCase(Cells(i, "E").Value)

        ' Verifica se o título contém alguma palavra-chave relacionada ao GTA 6
        encontrou = _
            InStr(texto, "gta 6") > 0 Or _
            InStr(texto, "gta vi") > 0 Or _
            InStr(texto, "grand theft auto") > 0 Or _
            InStr(texto, "vice city") > 0 Or _
            InStr(texto, "lucia") > 0 Or _
            InStr(texto, "jason") > 0 Or _
            InStr(texto, "rockstar") > 0 Or _
            InStr(texto, "take-two") > 0 Or _
            InStr(texto, "take two") > 0

        ' Oculta linhas que não possuem relação com o tema
        If Not encontrou Then
            Rows(i).Hidden = True
        End If

    Next i

    MsgBox "Filtro aplicado!"

End Sub
